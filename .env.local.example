# GitHub integration (Device Flow via a GitHub App — see server/README.md for how to obtain these)

# The GitHub App's Client ID. Safe to expose in the browser bundle — it is
# not a secret. This flow never uses a client secret at all.
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# The GitHub App's public install page, e.g. https://github.com/apps/<slug>/installations/new
# (find <slug> in the app's URL at github.com/settings/apps). Shown as a
# link when a connected user hasn't installed the app on any account yet,
# or has granted it zero repositories.
NEXT_PUBLIC_GITHUB_INSTALL_URL=

# Full URLs of the two device-flow relay endpoints (not base URLs — the
# path varies by deployment). Both endpoints just forward the request to
# GitHub and return its response verbatim; see server/README.md for why a
# relay is needed (GitHub's device-flow endpoints don't send CORS headers).
# The token endpoint also relays token refreshes (same GitHub URL, just a
# different grant_type in the body).
# For the standalone server/ auth service running locally:
NEXT_PUBLIC_GITHUB_DEVICE_CODE_ENDPOINT=http://localhost:4000/api/github/device/code
NEXT_PUBLIC_GITHUB_DEVICE_TOKEN_ENDPOINT=http://localhost:4000/api/github/device/token
# For a LoopControl-embedded deployment, these instead point at LoopControl's
# own endpoints, e.g. /api/v1/scxml-editor/github/device/code and
# .../github/device/token (same-origin, so relative paths work and no CORS
# config is needed).
